# PhotonEntry's production settings (/opt/photon/photonentry/.env, mode 600; docs/OPERATIONS.md §3). Names only in git: never real values.
ENVIRONMENT=production

# The database (the owner runs migrations only; the two logins are made by the first migration with these passwords).
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
SYSTEM_DB_PASSWORD=

# PhotonID (sign-in). OIDC_AUDIENCE is PhotonEntry's project id; OIDC_WEB_CLIENT_ID the web app's client id (other apps' tokens: /v1/summary only).
OIDC_ISSUER=https://id.photonind.com
OIDC_AUDIENCE=
OIDC_WEB_CLIENT_ID=
CORS_ORIGINS=https://entry.photonind.com
ACCOUNT_ORIGIN=https://account.photonind.com

# The PhotonID directory (organizations, sites, people): the product credential id1 issues when "entry" is in the catalog.
DIRECTORY_URL=https://api.account.photonind.com
DIRECTORY_CLIENT_ID=
DIRECTORY_CLIENT_SECRET=
DIRECTORY_NOTICE_SECRET=

# Card numbers and PINs at rest (Fernet, comma separated: the first encrypts) and their fingerprints.
SECRETS_KEY=
FINGERPRINT_KEY=

# Our own addresses, and the other products'.
WEB_URL=https://entry.photonind.com
PROVISION_URL=https://prov.entry.photonind.com
GUARD_API_URL=https://api.guard.photonind.com
VOX_API_URL=https://api.vox.photonind.com

# Mail (visitors' passes) through Postmark; empty: nothing is sent.
POSTMARK_TOKEN=
MAIL_FROM=PhotonEntry <entry@photonind.com>

# The web app (public values, served at /config.js).
VITE_OIDC_CLIENT_ID=
VITE_OIDC_AUDIENCE_PROJECT=
