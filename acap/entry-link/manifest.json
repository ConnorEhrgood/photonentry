{
  "schemaVersion": "1.7.1",
  "acapPackageConf": {
    "setup": {
      "appName": "entry_link",
      "friendlyName": "PhotonEntry Link",
      "vendor": "Photon",
      "vendorUrl": "https://photonind.com",
      "embeddedSdkVersion": "3.0",
      "runMode": "respawn",
      "version": "0.1.0"
    },
    "configuration": {
      "paramConfig": [
        {"name": "CloudUrl", "default": "https://link.entry.photonind.com", "type": "string"}
      ]
    }
  },
  "resources": {
    "dbus": {
      "requiredMethods": ["com.axis.HTTPConf1.VAPIXServiceAccounts1.GetCredentials"]
    }
  }
}
