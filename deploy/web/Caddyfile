# The web app as static files, with its security headers. TLS and routing are the host's Caddy's job (deploy/caddy/entry.caddy).
#   API_ORIGIN, OIDC_ORIGIN, DIRECTORY_API_ORIGIN   full origins the page may talk to (its Content-Security-Policy)
#   VITE_*                                           the app's own settings, served at /config.js (web/src/config.ts): public values
{
	auto_https off
	admin off
}

:8080 {
	handle /healthz {
		respond "ok" 200
	}
	handle /config.js {
		header Content-Type "application/javascript; charset=utf-8"
		header Cache-Control "no-cache"
		respond <<JS
			window.PE_CONFIG = {"VITE_API_URL":"{$VITE_API_URL}","VITE_OIDC_ISSUER":"{$VITE_OIDC_ISSUER}","VITE_OIDC_CLIENT_ID":"{$VITE_OIDC_CLIENT_ID}","VITE_OIDC_AUDIENCE_PROJECT":"{$VITE_OIDC_AUDIENCE_PROJECT}","VITE_DIRECTORY_APP_URL":"{$VITE_DIRECTORY_APP_URL}","VITE_DIRECTORY_API_URL":"{$VITE_DIRECTORY_API_URL}","VITE_DIRECTORY_AUDIENCE_PROJECT":"{$VITE_DIRECTORY_AUDIENCE_PROJECT}"}
			JS 200
	}
	handle {
		root * /srv
		encode zstd gzip
		header {
			X-Content-Type-Options nosniff
			Referrer-Policy no-referrer
			X-Frame-Options DENY
			-Server
			Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
			# A single-page app that signs in with OIDC (PKCE) and calls its API and the directory's (the app switcher). Nothing else.
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' {$API_ORIGIN} {$OIDC_ORIGIN} {$DIRECTORY_API_ORIGIN}; frame-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'self' {$OIDC_ORIGIN}"
		}
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@page not path /assets/*
		header @page Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
