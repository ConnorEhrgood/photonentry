{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://photonind.com/contract/entry/axis-settings-1.json",
  "title": "PhotonEntry settings for one Axis door controller (format axis-pacs-1)",
  "description": "Written by api/app/compiler/axis.py, applied by acap/entry-link. Every object is in the shape of Axis's access-control services (axsch Schedule, axudb User, pacsaxis AccessProfile and Credential, axtdc Door fields and DoorScheduleConfiguration). Only tokens beginning 'pe-' belong to PhotonEntry; doors are the controller's own and only the listed fields are set on them.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "controller_id", "site_id", "timezone", "schedules", "users", "access_profiles", "credentials", "doors", "door_schedules"],
  "$defs": {
    "token": {"type": "string", "pattern": "^pe-[a-z]-[A-Za-z0-9_-]{1,40}$"},
    "foreign": {"type": "string", "minLength": 1, "maxLength": 64},
    "time": {"type": "string", "pattern": "^$|^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$"},
    "duration": {"type": "string", "pattern": "^PT\\d+S$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 128},
    "empty": {"type": "array", "maxItems": 0}
  },
  "properties": {
    "format": {"const": "axis-pacs-1"},
    "controller_id": {"type": "string"},
    "site_id": {"type": "string"},
    "timezone": {"type": "string"},
    "schedules": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["token", "Name", "Description", "Attribute", "ScheduleDefinition", "ExceptionScheduleDefinition"],
      "properties": {
        "token": {"$ref": "#/$defs/token"}, "Name": {"$ref": "#/$defs/name"}, "Description": {"type": "string"},
        "Attribute": {"$ref": "#/$defs/empty"},
        "ScheduleDefinition": {"type": "string", "pattern": "^BEGIN:VCALENDAR"},
        "ExceptionScheduleDefinition": {"type": "string", "pattern": "^$|^BEGIN:VCALENDAR"}
      }}},
    "users": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["token", "Name", "Description", "Attribute"],
      "properties": {"token": {"$ref": "#/$defs/token"}, "Name": {"$ref": "#/$defs/name"}, "Description": {"type": "string"},
                     "Attribute": {"$ref": "#/$defs/empty"}}}},
    "access_profiles": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["token", "Name", "Description", "Enabled", "Schedule", "AuthenticationProfile", "Attribute", "AccessPolicy"],
      "properties": {
        "token": {"$ref": "#/$defs/token"}, "Name": {"$ref": "#/$defs/name"}, "Description": {"type": "string"}, "Enabled": {"type": "boolean"},
        "Schedule": {"type": "array", "items": {"$ref": "#/$defs/foreign"}, "minItems": 1},
        "AuthenticationProfile": {"$ref": "#/$defs/empty"}, "Attribute": {"$ref": "#/$defs/empty"},
        "AccessPolicy": {"type": "array", "minItems": 1, "items": {
          "type": "object", "additionalProperties": false, "required": ["AccessPoint", "AuthorizationProfile", "Attribute", "Schedule"],
          "properties": {"AccessPoint": {"$ref": "#/$defs/foreign"}, "AuthorizationProfile": {"$ref": "#/$defs/empty"},
                         "Attribute": {"$ref": "#/$defs/empty"}, "Schedule": {"type": "array", "items": {"$ref": "#/$defs/foreign"}, "minItems": 1}}}}
      }}},
    "credentials": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["token", "UserToken", "Description", "Enabled", "Status", "ValidFrom", "ValidTo", "IdData", "Attribute", "AuthenticationProfile", "CredentialAccessProfile"],
      "properties": {
        "token": {"$ref": "#/$defs/token"}, "UserToken": {"$ref": "#/$defs/token"}, "Description": {"type": "string"},
        "Enabled": {"type": "boolean"}, "Status": {"enum": ["Enabled", "Disabled"]},
        "ValidFrom": {"$ref": "#/$defs/time"}, "ValidTo": {"$ref": "#/$defs/time"},
        "IdData": {"type": "array", "minItems": 1, "maxItems": 1, "items": {
          "type": "object", "additionalProperties": false, "required": ["Name", "Value"],
          "properties": {"Name": {"enum": ["Card", "PIN"]}, "Value": {"type": "string", "pattern": "^[0-9a-f]+$"}}}},
        "Attribute": {"$ref": "#/$defs/empty"}, "AuthenticationProfile": {"$ref": "#/$defs/empty"},
        "CredentialAccessProfile": {"type": "array", "minItems": 1, "items": {
          "type": "object", "additionalProperties": false, "required": ["AccessProfile", "ValidFrom", "ValidTo"],
          "properties": {"AccessProfile": {"$ref": "#/$defs/token"}, "ValidFrom": {"$ref": "#/$defs/time"}, "ValidTo": {"$ref": "#/$defs/time"}}}}
      }}},
    "doors": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["token", "Name", "AccessTime", "OpenTooLongTime", "PreAlarmTime", "DoorScheduleConfiguration"],
      "properties": {
        "token": {"$ref": "#/$defs/foreign"}, "Name": {"$ref": "#/$defs/name"},
        "AccessTime": {"$ref": "#/$defs/duration"}, "OpenTooLongTime": {"$ref": "#/$defs/duration"}, "PreAlarmTime": {"$ref": "#/$defs/duration"},
        "DoorScheduleConfiguration": {"type": "string", "pattern": "^$|^pe-d-"}
      }}},
    "door_schedules": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["token", "Name", "Description", "DoorSchedule"],
      "properties": {
        "token": {"$ref": "#/$defs/token"}, "Name": {"$ref": "#/$defs/name"}, "Description": {"type": "string"},
        "DoorSchedule": {"type": "array", "minItems": 1, "maxItems": 1, "items": {
          "type": "object", "additionalProperties": false, "required": ["ScheduledState"],
          "properties": {"ScheduledState": {"type": "array", "minItems": 1, "items": {
            "type": "object", "additionalProperties": false, "required": ["ScheduleToken", "EnterAction"],
            "properties": {"ScheduleToken": {"type": "array", "items": {"$ref": "#/$defs/foreign"}, "minItems": 1},
                           "EnterAction": {"enum": ["Unlock", "Lock"]}}}}}}}
      }}}
  }
}
